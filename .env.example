# 冰冰小美知识库 — 环境变量配置
# 复制此文件为 .env 并填入真实值

# DeepSeek API Key（AI 冰美问答）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key

# Flask Secret Key（Session 加密）
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-flask-secret-key

# Tushare Token（A股数据，板块跟踪器用）
# 获取地址：https://tushare.pro/
TUSHARE_TOKEN=your-tushare-token

# 留言板管理密码
# 用于删除留言的后台操作
GUESTBOOK_ADMIN_KEY=your-admin-password

# 可选：应用根路径（子目录部署时使用）
# KB_APP_ROOT=

# mimo API Key（帖子自动打标用）
# 获取地址：https://token-plan-cn.xiaomimimo.com
MIMO_API_KEY=your-mimo-api-key

# Obsidian Vault 路径（词频分析、打标脚本用）
BBXM_VAULT_PATH=/path/to/obsidian/vault

# 词频分析输出目录（可选，默认在 vault 目录下）
# BBXM_OUTPUT_DIR=
